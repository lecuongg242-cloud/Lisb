    {
      "key": "zero-to-five",
      "title": { "vi": "Số 0 đến 5", "en-US": "Numbers 0 to 5" },
      "grammar_tip": {
        "vi": "Khi đọc số điện thoại, người ta đọc từng chữ số một. Số 0 có thể đọc là zero hoặc đọc như chữ O.",
        "en-US": "To say a phone number, say each number one by one. You can say 0 as zero, or like the letter O."
      },
      "pronunciation_tip": {
        "vi": "Three bắt đầu bằng âm /θ/: đặt đầu lưỡi giữa hai hàm răng rồi thổi hơi, đừng đọc thành \"tri\". Five kết thúc bằng âm /v/: răng trên chạm nhẹ môi dưới.",
        "en-US": "Three starts with /θ/: put your tongue between your teeth and blow. Five ends with /v/: your top teeth touch your bottom lip."
      },
      "words": [
        { "lemma": "zero", "pos": "number", "meaning": { "vi": "số không (0)", "en-US": "the number 0" }, "accepted": { "vi": ["không", "0", "số 0"] } },
        { "lemma": "one", "pos": "number", "meaning": { "vi": "số một (1)", "en-US": "the number 1" }, "accepted": { "vi": ["một", "1", "số 1"] } },
        { "lemma": "two", "pos": "number", "meaning": { "vi": "số hai (2)", "en-US": "the number 2" }, "accepted": { "vi": ["hai", "2", "số 2"] } },
        { "lemma": "three", "pos": "number", "meaning": { "vi": "số ba (3)", "en-US": "the number 3" }, "accepted": { "vi": ["ba", "3", "số 3"] } },
        { "lemma": "four", "pos": "number", "meaning": { "vi": "số bốn (4)", "en-US": "the number 4" }, "accepted": { "vi": ["bốn", "4", "số 4"] } },
        { "lemma": "five", "pos": "number", "meaning": { "vi": "số năm (5)", "en-US": "the number 5" }, "accepted": { "vi": ["năm", "5", "số 5"] } }
      ],
      "sentences": [
        { "key": "s1", "text": "One, two, three.", "accepted": ["1, 2, 3."], "translation": { "vi": "Một, hai, ba." }, "accepted_translation": { "vi": ["1, 2, 3."] } },
        { "key": "s2", "text": "Four and five.", "accepted": ["4 and 5."], "translation": { "vi": "Bốn và năm." }, "accepted_translation": { "vi": ["4 và 5."] } },
        { "key": "s3", "text": "Zero, one, two.", "accepted": ["0, 1, 2."], "translation": { "vi": "Không, một, hai." }, "accepted_translation": { "vi": ["0, 1, 2."] } },
        { "key": "s4", "text": "Three, two, one, zero.", "accepted": ["3, 2, 1, 0."], "translation": { "vi": "Ba, hai, một, không." }, "accepted_translation": { "vi": ["3, 2, 1, 0."] }, "note": { "vi": "Đếm ngược.", "en-US": "Counting down." } },
        { "key": "s5", "text": "Five, four, three.", "accepted": ["5, 4, 3."], "translation": { "vi": "Năm, bốn, ba." }, "accepted_translation": { "vi": ["5, 4, 3."] } }
      ]
    },
    {
      "key": "six-to-ten",
      "title": { "vi": "Số 6 đến 10", "en-US": "Numbers 6 to 10" },
      "grammar_tip": {
        "vi": "Number + số dùng để gọi tên theo số thứ tự: number seven là \"số bảy\" (bàn số 7, phòng số 7).",
        "en-US": "Use number + a number to name things: number seven (table number 7, room number 7)."
      },
      "pronunciation_tip": {
        "vi": "Six kết thúc bằng /ks/, phải nghe được âm \"x\" ở cuối. Seven có âm /v/ ở giữa. Eight kết thúc bằng /t/.",
        "en-US": "Six ends with /ks/. Seven has /v/ in the middle. Eight ends with /t/."
      },
      "words": [
        { "lemma": "six", "pos": "number", "meaning": { "vi": "số sáu (6)", "en-US": "the number 6" }, "accepted": { "vi": ["sáu", "6", "số 6"] } },
        { "lemma": "seven", "pos": "number", "meaning": { "vi": "số bảy (7)", "en-US": "the number 7" }, "accepted": { "vi": ["bảy", "7", "số 7"] } },
        { "lemma": "eight", "pos": "number", "meaning": { "vi": "số tám (8)", "en-US": "the number 8" }, "accepted": { "vi": ["tám", "8", "số 8"] } },
        { "lemma": "nine", "pos": "number", "meaning": { "vi": "số chín (9)", "en-US": "the number 9" }, "accepted": { "vi": ["chín", "9", "số 9"] } },
        { "lemma": "ten", "pos": "number", "meaning": { "vi": "số mười (10)", "en-US": "the number 10" }, "accepted": { "vi": ["mười", "10", "số 10"] } },
        { "lemma": "number", "pos": "noun", "meaning": { "vi": "số, con số", "en-US": "a word or sign like 1, 2, 3 that shows how many" }, "accepted": { "vi": ["số", "con số"] } }
      ],
      "sentences": [
        { "key": "s1", "text": "Six, seven, eight.", "accepted": ["6, 7, 8."], "translation": { "vi": "Sáu, bảy, tám." }, "accepted_translation": { "vi": ["6, 7, 8."] } },
        { "key": "s2", "text": "Nine and ten.", "accepted": ["9 and 10."], "translation": { "vi": "Chín và mười." }, "accepted_translation": { "vi": ["9 và 10."] } },
        { "key": "s3", "text": "Number seven, please.", "accepted": ["Number 7, please."], "translation": { "vi": "Số bảy, làm ơn." }, "accepted_translation": { "vi": ["Làm ơn cho số bảy.", "Số 7, làm ơn."] } },
        { "key": "s4", "text": "Ten, nine, eight.", "accepted": ["10, 9, 8."], "translation": { "vi": "Mười, chín, tám." }, "accepted_translation": { "vi": ["10, 9, 8."] } },
        { "key": "s5", "text": "Number six? Yes.", "accepted": ["Number 6? Yes."], "translation": { "vi": "Số sáu à? Vâng." }, "accepted_translation": { "vi": ["Số sáu phải không? Vâng.", "Số 6 à? Vâng."] } }
      ]
    },
    {
      "key": "eleven-to-fifteen",
      "title": { "vi": "Số 11 đến 15", "en-US": "Numbers 11 to 15" },
      "grammar_tip": {
        "vi": "Eleven và twelve là hai từ riêng. Từ 13 trở đi, số có đuôi -teen: thirteen, fourteen, fifteen.",
        "en-US": "Eleven and twelve are special words. From 13, the numbers end in -teen: thirteen, fourteen, fifteen."
      },
      "pronunciation_tip": {
        "vi": "Đuôi -teen đọc kéo dài \"tiin\" và được nhấn mạnh. Thirteen và fifteen đổi chữ so với three và five, đừng đọc thành \"threeteen\" hay \"fiveteen\".",
        "en-US": "Say -teen long and strong. Thirteen and fifteen change their spelling. Do not say \"threeteen\" or \"fiveteen\"."
      },
      "words": [
        { "lemma": "eleven", "pos": "number", "meaning": { "vi": "số mười một (11)", "en-US": "the number 11" }, "accepted": { "vi": ["mười một", "11", "số 11"] } },
        { "lemma": "twelve", "pos": "number", "meaning": { "vi": "số mười hai (12)", "en-US": "the number 12" }, "accepted": { "vi": ["mười hai", "12", "số 12"] } },
        { "lemma": "thirteen", "pos": "number", "meaning": { "vi": "số mười ba (13)", "en-US": "the number 13" }, "accepted": { "vi": ["mười ba", "13", "số 13"] } },
        { "lemma": "fourteen", "pos": "number", "meaning": { "vi": "số mười bốn (14)", "en-US": "the number 14" }, "accepted": { "vi": ["mười bốn", "14", "số 14"] } },
        { "lemma": "fifteen", "pos": "number", "meaning": { "vi": "số mười lăm (15)", "en-US": "the number 15" }, "accepted": { "vi": ["mười lăm", "15", "số 15"] } }
      ],
      "sentences": [
        { "key": "s1", "text": "Eleven and twelve.", "accepted": ["11 and 12."], "translation": { "vi": "Mười một và mười hai." }, "accepted_translation": { "vi": ["11 và 12."] } },
        { "key": "s2", "text": "Thirteen, fourteen, fifteen.", "accepted": ["13, 14, 15."], "translation": { "vi": "Mười ba, mười bốn, mười lăm." }, "accepted_translation": { "vi": ["13, 14, 15."] } },
        { "key": "s3", "text": "Number twelve, please.", "accepted": ["Number 12, please."], "translation": { "vi": "Số mười hai, làm ơn." }, "accepted_translation": { "vi": ["Làm ơn cho số mười hai.", "Số 12, làm ơn."] } },
        { "key": "s4", "text": "Fifteen? No, fourteen.", "accepted": ["15? No, 14."], "translation": { "vi": "Mười lăm à? Không, mười bốn." }, "accepted_translation": { "vi": ["Mười lăm phải không? Không, mười bốn.", "15 à? Không, 14."] } },
        { "key": "s5", "text": "Ten, eleven, twelve, thirteen.", "accepted": ["10, 11, 12, 13."], "translation": { "vi": "Mười, mười một, mười hai, mười ba." }, "accepted_translation": { "vi": ["10, 11, 12, 13."] } }
      ]
    },
    {
      "key": "sixteen-to-twenty",
      "title": { "vi": "Số 16 đến 20", "en-US": "Numbers 16 to 20" },
      "grammar_tip": {
        "vi": "Sixteen, seventeen, nineteen ghép từ six, seven, nine với đuôi -teen. Eighteen chỉ có một chữ t. Twenty là số tròn chục đầu tiên có đuôi -ty.",
        "en-US": "Sixteen, seventeen, and nineteen are six, seven, and nine plus -teen. Eighteen has only one t. Twenty ends in -ty."
      },
      "pronunciation_tip": {
        "vi": "Đuôi -teen kéo dài và được nhấn; đuôi -ty đọc ngắn và nhẹ. Phân biệt này rất quan trọng về sau (thirteen khác thirty). Twenty bắt đầu bằng cụm /tw/: đọc liền \"tw\", không chen nguyên âm.",
        "en-US": "Say -teen long and strong. Say -ty short and weak. This matters later (thirteen and thirty). Twenty starts with /tw/: say the two sounds together."
      },
      "words": [
        { "lemma": "sixteen", "pos": "number", "meaning": { "vi": "số mười sáu (16)", "en-US": "the number 16" }, "accepted": { "vi": ["mười sáu", "16", "số 16"] } },
        { "lemma": "seventeen", "pos": "number", "meaning": { "vi": "số mười bảy (17)", "en-US": "the number 17" }, "accepted": { "vi": ["mười bảy", "17", "số 17"] } },
        { "lemma": "eighteen", "pos": "number", "meaning": { "vi": "số mười tám (18)", "en-US": "the number 18" }, "accepted": { "vi": ["mười tám", "18", "số 18"] } },
        { "lemma": "nineteen", "pos": "number", "meaning": { "vi": "số mười chín (19)", "en-US": "the number 19" }, "accepted": { "vi": ["mười chín", "19", "số 19"] } },
        { "lemma": "twenty", "pos": "number", "meaning": { "vi": "số hai mươi (20)", "en-US": "the number 20" }, "accepted": { "vi": ["hai mươi", "20", "số 20"] } }
      ],
      "sentences": [
        { "key": "s1", "text": "Sixteen and seventeen.", "accepted": ["16 and 17."], "translation": { "vi": "Mười sáu và mười bảy." }, "accepted_translation": { "vi": ["16 và 17."] } },
        { "key": "s2", "text": "Eighteen, nineteen, twenty.", "accepted": ["18, 19, 20."], "translation": { "vi": "Mười tám, mười chín, hai mươi." }, "accepted_translation": { "vi": ["18, 19, 20."] } },
        { "key": "s3", "text": "Number twenty, please.", "accepted": ["Number 20, please."], "translation": { "vi": "Số hai mươi, làm ơn." }, "accepted_translation": { "vi": ["Làm ơn cho số hai mươi.", "Số 20, làm ơn."] } },
        { "key": "s4", "text": "Nineteen? Yes, nineteen.", "accepted": ["19? Yes, 19."], "translation": { "vi": "Mười chín à? Vâng, mười chín." }, "accepted_translation": { "vi": ["Mười chín phải không? Vâng, mười chín.", "19 à? Vâng, 19."] } },
        { "key": "s5", "text": "Sixteen, eighteen, twenty.", "accepted": ["16, 18, 20."], "translation": { "vi": "Mười sáu, mười tám, hai mươi." }, "accepted_translation": { "vi": ["16, 18, 20."] } }
      ]
    }
  ]
